---
interface Props {
  value: number;
  label: string;
}

const { value, label } = Astro.props;
const pct = Math.max(0, Math.min(100, Math.round(value)));
---

<div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct} aria-label={label}>
  <div class="fill" style={`width: ${pct}%`}></div>
</div>

<style>
  .bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--bg-block);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .fill {
    height: 100%;
    background: var(--accent);
  }
</style>
