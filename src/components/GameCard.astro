---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Release } from "../../scripts/lib/types";
import { STATUS_LABEL } from "../lib/games";
import ProgressBar from "./ProgressBar.astro";

interface Props {
  entry: CollectionEntry<"games">;
  latest: Release | null;
}

const { entry, latest } = Astro.props;
const g = entry.data;
---

<a class:list={["card", { downloadable: latest }]} href={`/game/${g.id}/`}>
  <div class="frame">
    {
      g.cover ? (
        <Image src={g.cover} alt="" widths={[360, 720]} sizes="(min-width: 960px) 20rem, (min-width: 640px) 45vw, 100vw" />
      ) : (
        <span class="placeholder">{g.title}</span>
      )
    }
  </div>
  <div class="body">
    <h2>{g.title}</h2>
    <p class="platform">{g.platform}</p>
    <p class="status">{STATUS_LABEL[g.status]} · {g.progress}%</p>
    <ProgressBar value={g.progress} label="Tiến độ dịch" />
    {latest && <p class="download">Tải bản v{latest.version}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-block);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card.downloadable {
    border-color: var(--accent);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
  .frame {
    aspect-ratio: 16 / 9;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    padding: 1rem;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    flex: 1;
  }
  h2 {
    margin: 0;
    font-size: 1.375rem;
    overflow-wrap: anywhere;
  }
  .platform {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .status {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  .download {
    margin: 0.25rem 0 0;
    font-weight: 600;
    color: var(--accent);
  }
</style>
